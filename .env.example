# Market data provider — alphavantage (default) or twelvedata
MARKET_DATA_PROVIDER=alphavantage

# Alpha Vantage API key — get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Twelve Data API key — get a free key at https://twelvedata.com/apikey
TWELVE_DATA_API_KEY=your_api_key_here

# Market data rate-limit gates in seconds. Defaults preserve free-tier safety.
# Recommended starting points:
# - Alpha Vantage Free: 12
# - Alpha Vantage Premium (75/min): 0.8
# - Twelve Data Free: 8
# - Twelve Data Grow (55/min): 1.1
# ALPHA_VANTAGE_MIN_INTERVAL_SECONDS=12
# TWELVE_DATA_MIN_INTERVAL_SECONDS=8

# Twelve Data rolling 60s credit budget (optional, takes precedence over
# TWELVE_DATA_MIN_INTERVAL_SECONDS). When set, the provider allows up to this
# many calls per minute to run concurrently — so a single refresh fires its
# independent daily/weekly/benchmark calls in parallel (~1-2s) instead of
# spacing every call out in series. Leave headroom under your plan's hard cap.
# Recommended: 50 for the Grow plan (55/min cap, 5-credit headroom). Unset =
# fall back to the strict per-call TWELVE_DATA_MIN_INTERVAL_SECONDS spacing.
# TWELVE_DATA_CREDITS_PER_MINUTE=50

# Logging level — DEBUG, INFO (default), WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Database connection. If not set, uses local SQLite (stocksentinal.db).
# For Supabase PostgreSQL, use the pooled connection string (port 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_ID:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase Auth — required for multi-user sign-in
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key
# SESSION_SECRET_KEY=your-random-secret-key-here
# SUPABASE_AUTH_PROVIDERS=google,github

# Admin notifications — receive an email when a new member signs up
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=your_smtp_password
# NOTIFY_FROM_EMAIL=you@example.com          # defaults to SMTP_USERNAME
# NOTIFY_ADMIN_EMAIL=admin@example.com       # comma-separated list of recipients
