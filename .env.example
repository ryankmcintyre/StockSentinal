# Market data provider — alphavantage (default) or twelvedata
MARKET_DATA_PROVIDER=alphavantage

# Alpha Vantage API key — get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Twelve Data API key — get a free key at https://twelvedata.com/apikey
TWELVE_DATA_API_KEY=your_api_key_here

# Logging level — DEBUG, INFO (default), WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Database connection. If not set, uses local SQLite (stocksentinal.db).
# For Supabase PostgreSQL, use the pooled connection string (port 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_ID:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase Auth — required for multi-user sign-in
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key
# SESSION_SECRET_KEY=your-random-secret-key-here
# SUPABASE_AUTH_PROVIDERS=google,github
